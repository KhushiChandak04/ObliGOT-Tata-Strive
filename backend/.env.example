APP_NAME=ObliGOT API
ENVIRONMENT=development
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=20
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service-account JSON for local Firestore/Auth access (git-ignored; relative paths resolve inside backend/).
# FIREBASE_CREDENTIALS_FILE=firebase-admin.json
# Or set the GOOGLE_APPLICATION_CREDENTIALS environment variable (a value in this file alone is not read by the Admin SDK).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# In Cloud Run / supported Google Cloud hosts, prefer Application Default Credentials.
REQUIRE_FIREBASE_AUTH=false
# Business timezone offset in minutes for deadline "today" (IST = 330).
BUSINESS_UTC_OFFSET_MINUTES=330
# Private folder for uploaded PDFs (relative to backend/; git-ignored). Not durable on Cloud Run.
DOCUMENT_STORAGE_DIR=.document_store
MAX_DOCUMENT_MB=20
MAX_DOCUMENT_PAGES=500
# Extraction: whole pages per Gemini call (characters) and per-call timeout.
EXTRACTION_CHUNK_CHARS=40000
# Scanned pages: rendered at this DPI and read by Gemini this many pages per request.
PAGE_RENDER_DPI=150
VISION_BATCH_PAGES=4
GEMINI_EXTRACTION_TIMEOUT_SECONDS=120

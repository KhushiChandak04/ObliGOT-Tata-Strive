APP_NAME=ObliGOT API
ENVIRONMENT=development
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_DOCUMENT_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=2
GROQ_BACKOFF_BASE_SECONDS=2
GROQ_MAX_RETRY_WAIT_SECONDS=30
GROQ_MAX_CONCURRENCY=2
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service-account JSON for local Firestore/Auth access (git-ignored; relative paths resolve inside backend/).
# FIREBASE_CREDENTIALS_FILE=firebase-admin.json
# Or set the GOOGLE_APPLICATION_CREDENTIALS environment variable (a value in this file alone is not read by the Admin SDK).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# In Cloud Run / supported Google Cloud hosts, prefer Application Default Credentials.
REQUIRE_FIREBASE_AUTH=false
# Explicitly use fictional, process-local data instead of Firestore. Restart the backend after changing this.
OBLIGOT_DEMO_MODE=false
# Optional local-only resilience: on Firestore failure, switch this process to synthetic memory data.
OBLIGOT_AUTO_DEMO_FALLBACK=false
# Business timezone offset in minutes for deadline "today" (IST = 330).
BUSINESS_UTC_OFFSET_MINUTES=330
# Private folder for uploaded PDFs (relative to backend/; git-ignored). Not durable on Cloud Run.
DOCUMENT_STORAGE_DIR=.document_store
MAX_DOCUMENT_MB=20
MAX_DOCUMENT_PAGES=500
# Extraction: whole pages per Groq call (characters) and per-call timeout.
EXTRACTION_CHUNK_CHARS=40000
# Scanned pages: rendered at this DPI; Groq vision accepts at most three page images per request.
PAGE_RENDER_DPI=150
VISION_BATCH_PAGES=3
# Regional defaults (Tata STRIVE, India)
DEFAULT_CURRENCY=INR
DATE_ORDER=dmy
NUMBER_DECIMAL_SEPARATOR=.
# Optional local OCR fallback (needs Tesseract installed)
OCR_ENABLED=true
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng
